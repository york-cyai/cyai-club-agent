# Copy this file to backend/.env for local development and fill in real values.
# Never commit backend/.env. Every variable in app/config.py is listed here.
# On Render, set these as environment variables instead of using a .env file.

# --- Required on Render ---
# Supabase connection string on Render; the SQLite default below is for local use only.
DATABASE_URL=sqlite:///./cyai_agent.db
# Shared key: the website sends it as x-api-key. Must equal the website's VITE_API_KEY.
AGENT_API_KEY=your_agent_api_key_here
# Signs unsubscribe and other links. Generate with: openssl rand -hex 32
TOKEN_SECRET_KEY=generate_a_random_secret_here

# --- Website addresses allowed to call the API (CORS) ---
# Optional, comma-separated, no trailing slash. Added to the defaults in app/config.py.
ALLOWED_ORIGINS=

# --- Gmail sending (see GMAIL_TOKEN_RENEWAL.md) ---
GMAIL_ADDRESS=your_club_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here
GMAIL_CLIENT_ID=your_gmail_oauth_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_oauth_client_secret_here
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token_here

# --- AI and search services ---
GEMINI_API_KEY=your_gemini_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_API_KEY=your_adzuna_api_key_here

# --- Not used for the database connection ---
# Present in app/config.py but the app connects with DATABASE_URL only.
SUPABASE_DATABASE_URL=
